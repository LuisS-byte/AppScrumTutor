<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F7F7F7"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvTituloHistoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/story_title_sample"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#222" />

    <TextView
        android:id="@+id/tvDescripcionHistoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/story_description_sample"
        android:textSize="14sp"
        android:textColor="#555"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/tvPrioridadHistoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/story_priority_high"
        android:textSize="13sp"
        android:textColor="#1E88E5"
        android:paddingTop="4dp" />
</LinearLayout>
