<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#FFFFFF"
    android:padding="32dp"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:text="@string/titulo_crear_cuenta"
            android:textColor="#043255"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <!-- CAMPOS -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre_completo"
            android:padding="14dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_correo_registro"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_contrasena_registro"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_confirmar_contrasena"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"/>

        <!-- BOTÓN REGISTRO -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:text="@string/btn_registrarse"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A84FF"/>

        <!-- LINK INICIO DE SESIÓN -->
        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/txt_ir_login"
            android:textColor="#0A84FF"
            android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>
