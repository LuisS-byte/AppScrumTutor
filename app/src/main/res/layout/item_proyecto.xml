<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp"
    android:elevation="3dp">

    <!-- Columna de texto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreProyecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/project_item_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvDescripcionProyecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/project_item_description"
            android:textSize="14sp"
            android:textColor="#666666"/>
    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnIrProyecto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/project_go"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnEditarProyecto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/project_edit"
            android:backgroundTint="@android:color/holo_green_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnEliminarProyecto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/project_delete"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
