<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_gestion_sprint"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingBottom="16dp"/>

        <EditText
            android:id="@+id/etNombreSprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre_sprint"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etObjetivoSprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_objetivo_sprint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSeleccionarHistorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_seleccionar_historias"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvHistoriasSeleccionadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_historias_seleccionadas"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etFechaInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_fecha_inicio_sprint"
            android:inputType="date" />

        <EditText
            android:id="@+id/etFechaFin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_fecha_fin_sprint"
            android:inputType="date" />

        <Spinner
            android:id="@+id/spEstadoSprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:entries="@array/estado_sprint" />

        <Button
            android:id="@+id/btnGuardarSprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_guardar_sprint"
            android:layout_marginTop="24dp"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
