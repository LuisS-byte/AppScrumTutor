<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#043255"
    android:padding="20dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="30dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="10dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:text="@string/titulo_bienvenido"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#043255" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E" />

        <!-- Olvidó contraseña -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/txt_olvido_contrasena"
            android:textColor="#0A84FF"
            android:textSize="14sp" />

        <!-- Botón login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0A84FF"
            android:text="@string/btn_iniciar_sesion"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Ir a registro -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/txt_crear_cuenta"
            android:textColor="#0A84FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/txt_continuar_con"
            android:textSize="14sp"
            android:textColor="#3A4F61" />

        <!-- Botón Google -->
        <ImageButton
            android:id="@+id/btnGoogle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:src="@drawable/googleicon" />

    </LinearLayout>

</ScrollView>
