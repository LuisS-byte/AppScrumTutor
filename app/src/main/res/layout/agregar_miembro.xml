<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#043255">

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_margin="4dp">

        <!-- Input correo -->
        <EditText
            android:id="@+id/etCorreoMiembro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico del usuario"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="#F2F7FA"
            android:textColor="#043255"
            android:textColorHint="#97A8B8" />

        <!-- Rol -->
        <Spinner
            android:id="@+id/spRolMiembro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <!-- Botón confirmar -->
        <Button
            android:id="@+id/btnConfirmarInvitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INVITAR MIEMBRO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A84FF"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginTop="20dp" />
    </LinearLayout>

</LinearLayout>
