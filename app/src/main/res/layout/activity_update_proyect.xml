<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    android:background="#043255"
    tools:context=".updateProyect">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:layout_marginHorizontal="4dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTituloEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_project_title"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#043255"
            android:textSize="22sp"
            android:paddingBottom="20dp"/>

        <!-- CAMPOS -->
        <EditText
            android:id="@+id/etNombreProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/project_name_hint"
            android:background="#F2F7FA"
            android:padding="14dp"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDescripcionProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/project_description_hint"
            android:minHeight="120dp"
            android:gravity="top"
            android:background="#F2F7FA"
            android:padding="14dp"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etFechaInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/project_start_date_hint"
            android:background="#F2F7FA"
            android:padding="14dp"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etFechaFin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/project_end_date_hint"
            android:background="#F2F7FA"
            android:padding="14dp"
            android:textColor="#043255"
            android:textColorHint="#6E8A9E"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="20dp"/>

        <!-- BOTÓN -->
        <Button
            android:id="@+id/btnActualizarProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_project_button"
            android:textStyle="bold"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A84FF"/>
    </LinearLayout>
</ScrollView>
