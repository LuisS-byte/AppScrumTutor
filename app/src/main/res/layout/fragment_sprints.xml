<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tvTituloProyecto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sprints_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#043255"
        android:paddingBottom="12dp" />

    <!-- LISTADO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutSprints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- BOTÓN CREAR SPRINT -->
    <Button
        android:id="@+id/btnCrearSprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/create_new_sprint"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0A84FF"
        android:layout_marginTop="8dp" />

    <!-- BOTÓN VER MIEMBROS -->
    <Button
        android:id="@+id/btnVerMiembros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_project_members"
        android:textColor="#FFFFFF"
        android:backgroundTint="#043255"
        android:layout_marginTop="10dp" />

</LinearLayout>
