<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="#FFFFFF">



    <!-- CONTENIDO SCROLLEABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sección Sprint actual -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sprint - Módulo Autenticación"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutSprintTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnCrearHistoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREAR HISTORIA/TAREA"
                android:backgroundTint="@android:color/holo_blue_light"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Sección Backlog general -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Backlog"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnCrearSprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CREAR SPRINT"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@android:color/holo_blue_dark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBacklogTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <Button
                android:id="@+id/btnAgregarTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREAR HISTORIA/TAREA"
                android:backgroundTint="@android:color/holo_blue_light"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>
