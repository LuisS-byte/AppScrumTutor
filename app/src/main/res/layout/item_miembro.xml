<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:backgroundTint="#FFFFFF"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="#F2F7FA"
            android:padding="6dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/member_avatar_desc" />

        <!-- Información del miembro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreMiembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_name_sample"
                android:textStyle="bold"
                android:textColor="#043255"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRolMiembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_role_sample"
                android:textColor="#3A4F61"
                android:textSize="14sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/tvEstadoMiembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_status_active"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:paddingTop="3dp" />
        </LinearLayout>

        <!-- Botón eliminar -->
        <Button
            android:id="@+id/btnEliminarMiembro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/member_delete"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#D32F2F" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
